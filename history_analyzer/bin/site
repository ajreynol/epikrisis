font-family:var(--mono);font-size:.73rem;color:var(--ink3);line-height:1.7}
:focus-visible{outline:2px solid var(--derived);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
@media (max-width:640px){.wrap{padding:0 18px 72px}.mast{padding-top:36px}}
"""



def page(title, body, crumb="", desc=""):
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="description" content="{html.escape(desc, quote=True)}">
<title>{html.escape(title)}</title>
<style>{CSS}</style>
</head>
<body>
<div class="wrap">
{crumb}
{body}
<footer>
epikrisis &middot; evidence and analysis for repositories in the Eunoia ecosystem &middot;
<a href="https://github.com/ajreynol/epikrisis">source</a><br>
Every run here is a <strong>self-assessment</strong>: the subject is a family of trees
that contains the tool. Its conclusions are not cited outward &mdash; not as evidence
that these practices work, not in a vision document, not in a README.
</footer>
</div>
</body>
</html>
"""


# --------------------------------------------------------------------- build

def runs():
    found = []
    for subject in sorted(os.listdir(RUNS)):
        d = os.path.join(RUNS, subject)
        if not os.path.isdir(d):
            continue
        for stamp in sorted(os.listdir(d)):
            rd = os.path.join(d, stamp)
            cp = os.path.join(rd, "corpus.json")
            if not os.path.isfile(cp):
                continue
            prose = [f for f in PROSE if os.path.isfile(os.path.join(rd, f))]
            found.append(dict(subject=subject, stamp=stamp, dir=rd, prose=prose,
                              corpus=json.load(open(cp))))
    if not found:
        raise SystemExit("site: no runs with a corpus.json; nothing to build")
    return found


def main():
    if len(sys.argv) != 2:
        raise SystemExit("usage: site <out-dir>")
    out = os.path.abspath(sys.argv[1])
    if os.path.commonpath([out, RUNS]) == RUNS:
        raise SystemExit("site: refusing to write the site into runs/; the "
                         "output is a build artifact and the input is evidence")
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)

    rows, pages = [], 0
    for r in sorted(runs(), key=lambda r: (r["stamp"], r["subject"]), reverse=True):
        c, rel = r["corpus"], f"{r['subject']}/{r['stamp']}"
        dst = os.path.join(out, rel)
        os.makedirs(dst, exist_ok=True)
        n = sum(s["commits"] for s in c["sources"])
        links = []
        for f in r["prose"]:
            src = os.path.join(r["dir"], f)
            crumb = (f'<div class="crumb"><a href="../../index.html">All runs</a> '
                     f'&nbsp;/&nbsp; <code>{html.escape(rel)}</code></div>')
            body = convert(open(src).read(), os.path.join(rel, f), rel)
            name = f[:-3] + ".html"
            open(os.path.join(dst, name), "w").write(
                page(f"{TITLES[f]} — {r['subject']} {r['stamp']}", body, crumb,
                     f"{TITLES[f]} for the {r['subject']} run pinned "
                     f"{r['stamp']}: {len(c['sources'])} sources, {n:,} commits."))
            links.append(f'<a href="{rel}/{name}">{TITLES[f]}</a>')
            pages += 1
        for f in sorted(os.listdir(r["dir"])):
            if f.endswith(".svg"):
                shutil.copy(os.path.join(r["dir"], f), dst)
        ev = f'<a href="{TREE}/history_analyzer/runs/{rel}">evidence</a>'
        rows.append(
            f"<tr><td><code>{html.escape(r['subject'])}</code></td>"
            f"<td><code>{html.escape(r['stamp'])}</code></td>"
            f"<td>{len(c['sources'])}</td><td>{n:,}</td>"
            f"<td>{' &middot; '.join(links) if links else '&mdash;'} "
            f"&middot; {ev}</td></tr>")

    idx = f"""<div class="mast">
<div class="eyebrow">epikrisis &middot; history analyzer</div>
<h1>What these repositories did, on evidence a reader can re-derive</h1>
<p>Epikrisis reads the git histories of the <strong>Eunoia ecosystem</strong> at pinned
commits and asks what happened, what worked, what went wrong, and where the recorded
account differs from the tree. Every run below is committed: the evidence, the report
written from it, and the reason every candidate event was cited or dropped.</p>
</div>

<blockquote class="q alert important"><p><strong>These are self-assessments, and their
conclusions do not travel.</strong> The subject of each run is a family of trees that
contains this tool, so each is marked <code>self</code> and its findings are never cited
outward &mdash; not as evidence that these practices work, not in a vision document, not
in a README. A family grading itself with its own instrument produces something useful to
the family and worthless to anybody else. <strong>What is addressed to a reader from
outside is the method</strong>: the
<a href="{REPO}/history_analyzer/docs/design.md">pipeline design</a>, the
<a href="{REPO}/history_analyzer/docs/events.md">detector catalogue</a> with its failure
modes, the <a href="{REPO}/history_analyzer/docs/judgement.md">report requirements</a>,
and the <a href="{REPO}/history_analyzer/docs/notes.md">open defects</a>. Read the runs as
worked examples of that method, not as findings you should believe.</p></blockquote>

<h2 id="runs">Runs</h2>
<p>Newest first. Sources and commits are read from each run&rsquo;s own
<code>corpus.json</code>; a run with no prose reached the evidence stages and was
never written up.</p>
<div class="tw"><table><thead><tr><th>subject</th><th>pinned</th><th>sources</th>
<th>commits</th><th>what there is to read</th></tr></thead>
<tbody>{''.join(rows)}</tbody></table></div>
"""
    open(os.path.join(out, "index.html"), "w").write(
        page("epikrisis — history reports", idx, "",
             "Reports on how the Eunoia ecosystem's repositories evolved, each "
             "built from committed evidence at pinned commits."))
    print(f"  {pages} prose page(s) and an index for {len(rows)} run(s) -> {out}")


if __name__ == "__main__":
    main()
