def page(title, body, crumb="", desc=""):
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="description" content="{html.escape(desc, quote=True)}">
<title>{html.escape(title)}</title>
<style>{CSS}</style>
</head>
<body>
<div class="wrap">
{crumb}
{body}
<footer>
epikrisis &middot; evidence and analysis for repositories in the Eunoia ecosystem &middot;
<a href="https://github.com/ajreynol/epikrisis">source</a><br>
History reports marked <strong>self-assessment</strong> concern a family of trees
that contains the tool. Their conclusions are not cited outward as evidence that
these practices work. LOC reports publish repository-size measurements at named commits.
</footer>
</div>
</body>
</html>
"""


# --------------------------------------------------------------------- build

def runs():
    found = []
    for subject in sorted(os.listdir(RUNS)):
        d = os.path.join(RUNS, subject)
        if not os.path.isdir(d):
            continue
        for stamp in sorted(os.listdir(d)):
            rd = os.path.join(d, stamp)
            cp = os.path.join(rd, "corpus.json")
            if not os.path.isfile(cp):
                continue
            prose = [f for f in PROSE if os.path.isfile(os.path.join(rd, f))]
            found.append(dict(subject=subject, stamp=stamp, dir=rd, prose=prose,
                              corpus=json.load(open(cp))))
    if not found:
        raise SystemExit("site: no runs with a corpus.json; nothing to build")
    return found


def tracked_commits(c, detail=False):
    """Render the counts kept alongside (not added to) the assessed corpus."""
    tracking = c.get("commit_tracking")
    if not tracking:
        return ""
    rows = []
    for s in tracking["sources"]:
        label = html.escape(f"{s['id']} ({s['ref']})")
        url = html.escape(s["origin"].rstrip("/") + "/commit/" + s["commit"])
        pin = f'<a href="{url}"><code>{s["commit"][:12]}</code></a>'
        if detail:
            rows.append(f"<tr><td>{label}</td><td>{s['commits']:,}</td>"
                        f"<td>{pin}</td></tr>")
        else:
            rows.append(f"{label}: <strong>{s['commits']:,}</strong> ({pin})")
    if not detail:
        return "<br>".join(rows)
    method = html.escape(tracking["method"])
    cutoff = (f" Cutoff: <code>{html.escape(tracking['cutoff'])}</code>. "
              "This reconstructs the history at the latest source-commit time; "
              "the original wall-clock pin time was not recorded."
              if tracking.get("cutoff") else "")
    return ('<aside><h2 id="tracked-commits">cvc5 and Ethos commit tracking</h2>'
            '<p>Whole-history counts on the named branches, with their commit '
            'pins. These supplement the assessed corpus; its source and commit '
            'totals above retain their original scope.</p>'
            f'<p>{method}.{cutoff}</p><div class="tw"><table><thead><tr>'
            '<th>repository (branch)</th><th>commits</th><th>pin</th>'
            '</tr></thead><tbody>' + "".join(rows) + '</tbody></table></div></aside>')


def overview(corpus, spec, fig):
    sources, series = figures.figure_data(corpus, spec, fig)
    windows = [p for p in fig["panels"] if p != "corpus"]
    totals = {"repositories": len(sources), "all_time": sum(s["commits"] for s in sources)}
    totals.update({p: sum(series[p]["values"][s["id"]] for s in sources) for p in windows})
    tracked = {s["id"] for s in corpus.get("commit_tracking", {}).get("sources", [])}
    rows = []
    for src in sources:
        label = src["id"] + (f" ({src['ref']})" if src["id"] in tracked else "")
        url = src["origin"].rstrip("/") + "/commit/" + src["commit"]
        counts = [src["commits"]] + [series[p]["values"][src["id"]] for p in windows]
        rows.append(f'<tr><td><a href="{html.escape(url)}">{html.escape(label)}</a></td>'
                    + "".join(f"<td>{n:,}</td>" for n in counts) + "</tr>")
    table = ('<div class="tw"><table id="commit-overview"><thead><tr>'
             '<th>repository</th><th>whole history</th>'
             + "".join(f'<th>{html.escape(series[p]["label"])}</th>' for p in windows)
             + '</tr></thead><tbody>' + "".join(rows) + '</tbody><tfoot><tr>'
             '<th>Total, all repositories shown</th>'
             + "".join(f'<td><strong>{totals[p]:,}</strong></td>'
                       for p in ["all_time"] + windows)
             + '</tr></tfoot></table></div>')
    return table, totals


def main():
    if len(sys.argv) != 2:
        raise SystemExit("usage: site <out-dir>")
    out = os.path.abspath(sys.argv[1])
    if os.path.commonpath([out, RUNS]) == RUNS:
        raise SystemExit("site: refusing to write the site into runs/; the "
                         "output is a build artifact and the input is evidence")
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)

    rows, pages, built = [], 0, []
    for r in sorted(runs(), key=lambda r: (r["stamp"], r["subject"]), reverse=True):
        c, rel = r["corpus"], f"{r['subject']}/{r['stamp']}"
        built.append(r)
        dst = os.path.join(out, rel)
        os.makedirs(dst, exist_ok=True)
        n = sum(s["commits"] for s in c["sources"])
        links = []
        for f in r["prose"]:
            src = os.path.join(r["dir"], f)
            crumb = (f'<div class="crumb"><a href="../../index.html">All runs</a> '
                     f'&nbsp;/&nbsp; <code>{html.escape(rel)}</code></div>')
            body = ('<article>' + convert(open(src).read(), os.path.join(rel, f), rel)
                    + '</article>' + tracked_commits(c, detail=True))
            name = f[:-3] + ".html"
            open(os.path.join(dst, name), "w").write(
                page(f"{TITLES[f]} — {r['subject']} {r['stamp']}", body, crumb,
                     f"{TITLES[f]} for the {r['subject']} run pinned "
                     f"{r['stamp']}: {len(c['sources'])} sources, {n:,} commits."))
            links.append(f'<a href="{rel}/{name}">{TITLES[f]}</a>')
            pages += 1
        for f in sorted(os.listdir(r["dir"])):
            if f.endswith(".svg"):
                shutil.copy(os.path.join(r["dir"], f), dst)
        ev = f'<a href="{TREE}/history_analyzer/runs/{rel}">evidence</a>'
        rows.append(
            f"<tr><td><code>{html.escape(r['subject'])}</code></td>"
            f"<td><code>{html.escape(r['stamp'])}</code></td>"
            f"<td>{len(c['sources'])}</td><td>{n:,}</td>"
            f"<td>{tracked_commits(c) or '&mdash;'}</td>"
            f"<td>{' &middot; '.join(links) if links else '&mdash;'} "
            f"&middot; {ev}</td></tr>")

    # ---- the landing page: editorial copy from site.json, figures from runs
    cfg_p = os.path.join(HERE, "site.json")
    cfg = json.load(open(cfg_p)) if os.path.exists(cfg_p) else {}
    by = {(r["subject"], r["stamp"]): r for r in built}

    def doc_href(it):
        key = (it["subject"], it["stamp"])
        if key not in by or it["doc"] not in by[key]["prose"]:
            raise SystemExit("site: site.json points at %s/%s/%s, which this "
                             "build does not produce"
                             % (it["subject"], it["stamp"], it["doc"]))
        return "%s/%s/%s.html" % (it["subject"], it["stamp"], it["doc"][:-3])

    esc = html.escape
    parts = ['<div class="mast">'
             '<div class="eyebrow">%s</div><h1>%s</h1>'
             '<div class="lede">%s</div></div>'
             % (esc(cfg.get("tagline", "epikrisis")),
                esc(cfg.get("title", "epikrisis")),
                convert(cfg.get("lede", ""), "site.json", ""))]

    hl = cfg.get("highlight")
    if hl:
        href = doc_href(hl)
        base = "%s/%s" % (hl["subject"], hl["stamp"])
        run = by[(hl["subject"], hl["stamp"])]
        table, totals, fig = "", {}, ""
        if hl.get("figure"):
            spec = json.load(open(os.path.join(run["dir"], "figures.json")))
            definition = next(f for f in spec["figures"] if f["name"] == hl["figure"])
            table, totals = overview(run["corpus"], spec, definition)
            panels, sub, alt, count = figures.build_figure(run["corpus"], spec, definition)
            # Rebuild the homepage chart from the same data as its table and tiles.
            for mode in ("light", "dark"):
                target = os.path.join(out, base, f"{hl['figure']}-{mode}.svg")
                open(target, "w").write(figures.render(
                    mode, panels, definition["heading"], sub, alt, count))
            fig = ('<picture><source media="(prefers-color-scheme: dark)" '
                   'srcset="%s/%s-dark.svg">'
                   '<img alt="%s" src="%s/%s-light.svg">'
                   '</picture>' % (base, hl["figure"], esc(alt), base, hl["figure"]))
        tiles = "".join(
            '<div class="stat %s"><b>%s</b><span>%s</span></div>'
            % (esc(t.get("cls", "h")),
               f'{totals[t["measure"]]:,}' if "measure" in t else esc(t["n"]),
               inline(t["cap"], base))
            for t in hl.get("stats", []))
        parts.append(
            '<section class="hero"><div class="eyebrow">%s</div>'
            '<h2><a href="%s">%s</a></h2><div class="blurb">%s</div>'
            '<div class="stats">%s</div>%s%s'
            '<p class="cta"><a href="%s">%s &rarr;</a></p></section>'
            % (esc(hl.get("eyebrow", "")), href, esc(hl.get("title", "")),
               convert(hl.get("blurb", ""), "site.json", base), tiles, fig, table,
               href, esc(hl.get("cta", "Read it"))))

    for sec in cfg.get("sections", []):
        cards = "".join(
            '<a class="card" href="%s"><h3>%s</h3><p>%s</p>'
            '<span class="where">%s &middot; %s</span></a>'
            % (doc_href(it), esc(it["title"]),
               inline(it["blurb"], "%s/%s" % (it["subject"], it["stamp"])),
               esc(it["subject"]), esc(it["stamp"])) for it in sec["items"])
        parts.append('<section><h2>%s</h2><p class="sec-blurb">%s</p>'
                     '<div class="cards">%s</div></section>'
                     % (esc(sec["title"]), inline(sec.get("blurb", ""), ""), cards))

    if cfg.get("method"):
        cards = "".join(
            '<a class="card flat" href="%s/%s"><h3>%s</h3><p>%s</p></a>'
            % (REPO, m["href"], esc(m["title"]), inline(m["blurb"], ""))
            for m in cfg["method"])
        parts.append(
            '<section><h2>How it works</h2><p class="sec-blurb">Read these rather '
            'than the findings if you have arrived from outside this ecosystem: '
            'the conclusions here are a family grading itself, and do not travel. '
            'The method does.</p><div class="cards">%s</div></section>' % cards)

    parts.append(
        '<section><h2>Everything else</h2><p class="sec-blurb">Twelve runs are '
        'committed and most were never written up: a pin and its candidate '
        'events, kept so a later reader can tell what was looked at. '
        '<a href="runs.html">The full listing</a> says which carry prose, and '
        'links the evidence behind each.</p></section>')

    open(os.path.join(out, "index.html"), "w").write(
        page(cfg.get("title", "epikrisis"), "\n".join(parts), "",
             "How the repositories of the Eunoia ecosystem have developed, "
             "measured from their git histories at pinned commits."))

    # ---- the run listing: the internal view, on its own page
    listing = ('<h1>Every run</h1><p class="lede">One row per pinned corpus. '
               'Sources and commits are read from each run’s own '
               '<code>corpus.json</code>; a run with no prose reached the '
               'evidence stages and was never written up. cvc5 and Ethos '
               'main-branch counts supplement ecosystem runs and are shown '
               'separately from the assessed corpus totals. Historical counts '
               'are reconstructed at the latest source-commit timestamp in '
               'each run; the cutoff and full pins are in its manifest. '
               'Newest first.</p>'
               '<div class="tw"><table><thead><tr><th>subject</th><th>pinned</th>'
               '<th>assessed sources</th><th>assessed commits</th>'
               '<th>tracked commits</th><th>what there is to read</th>'
               '</tr></thead><tbody>%s</tbody></table></div>' % "".join(rows))
    open(os.path.join(out, "runs.html"), "w").write(
        page("Every run — epikrisis", listing,
             '<div class="crumb"><a href="index.html">&larr; epikrisis</a></div>',
             "Every pinned corpus epikrisis has produced, and its evidence."))
    pages += 1

    print(f"  {pages} prose page(s) and an index for {len(rows)} run(s) -> {out}")
    return cfg, parts


if __name__ == "__main__":
    main()
