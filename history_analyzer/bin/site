#!/usr/bin/env python3
"""site -- build the public report site from what is committed under runs/.

The site is a **rendering and never a source**. Every page it produces comes
from a run directory: the index is derived from each run's `corpus.json`, and
each prose page is the markdown in that directory converted to HTML. Nothing is
written here that is not already in the tree, so the site cannot say anything the
repository does not.

**The converter refuses what it does not understand.** A markdown feature it has
not been taught is an error and never a guess, because a renderer that quietly
drops a table row or mangles a figure produces a page that reads correctly and is
wrong -- which is the failure this repository is arranged against. The supported
set is exactly what the run documents use, and widening it is a deliberate edit.

**It is not part of the analyzer.** It reads no history, runs no `git`, and
decides nothing; the pipeline's output does not depend on it. Like `bin/figures`
it is outside what `epikrisis budget` meters, which is recorded in
../docs/notes.md rather than relied on.

    site <out-dir>

Stdlib only, no network. The output directory is a build artifact and is not
committed; CI builds it and GitHub Pages serves it.
"""
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import sys

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_loader = importlib.machinery.SourceFileLoader("epikrisis_figures", os.path.join(HERE, "bin", "figures"))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
figures = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(figures)
RUNS = os.path.join(HERE, "runs")
REPO = "https://github.com/ajreynol/epikrisis/blob/main"
# GitHub serves a directory under /tree/ and redirects /blob/ to it. Emitting
# the redirect costs a round trip on every evidence link on the index.
TREE = "https://github.com/ajreynol/epikrisis/tree/main"

# Prose that is a run's own output. Anything else in a run directory is evidence
# and is linked as a file rather than rendered as a page.
PROSE = ("case-study.md", "stretches.md", "report.md", "note.md")

TITLES = {"report.md": "Report", "case-study.md": "Case study",
          "stretches.md": "Snapshot history", "note.md": "Note"}


# ------------------------------------------------------------------ markdown

class Unsupported(Exception):
    """A construct the converter has not been taught. Never guessed at."""


REFUSE = [
    (re.compile(r"!\["), "an image; figures arrive through a <picture> block"),
    (re.compile(r"\[\^"), "a footnote"),
    (re.compile(r"~~"), "strikethrough"),
    (re.compile(r"^#{4,} "), "a heading below level 3"),
    (re.compile(r"^\s{4,}\S"), "an indented code block; use a fence"),
]
# What begins a block, and therefore ends a paragraph.
BLOCK = re.compile(r"^(#{1,3} |\||>|```|<|-{3,}$|\d+\. |[-*] )")

RAW_OK = ("<picture>", "</picture>", "<source", "<img", "<details", "</details>",
          "<summary", "</summary>", "<div", "</div>")


def inline(s, rel):
    """Code spans first, so nothing inside them is treated as markup."""
    spans = []

    def stash(m):
        spans.append(m.group(1))
        return f"\x00{len(spans)-1}\x00"

    s = re.sub(r"`([^`]+)`", stash, s)
    s = html.escape(s, quote=False)
    s = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)",
               lambda m: f'<a href="{html.escape(link(m.group(2), rel), quote=True)}">'
                         f"{m.group(1)}</a>", s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<!\*)\*([^*\n]+)\*(?!\*)", r"<em>\1</em>", s)
    return re.sub(r"\x00(\d+)\x00",
                  lambda m: f"<code>{html.escape(spans[int(m.group(1))])}</code>", s)


def link(t, rel):
    """A link the site carries stays relative; everything else goes to GitHub.

    A page that silently links nowhere is the characteristic cost of rendering a
    document away from the tree it was written in. The site carries prose and
    figures and nothing else, so a link to evidence -- `figures.json`, an events
    file -- resolves into the repository instead of to a file that is not here.
    """
    if t.startswith(("http", "mailto:", "#")):
        return t
    if t.endswith(PROSE):
        return t[:-3] + ".html"
    if t.endswith(".svg"):
        return t                       # copied beside the page
    here = f"history_analyzer/runs/{rel}"
    return f"{REPO}/{os.path.normpath(os.path.join(here, t))}"


def slug(h):
    return re.sub(r"\s+", "-", re.sub(r"[^\w\s-]", "", re.sub(r"<[^>]+>", "", h)
                                      .strip().lower()))


def convert(text, where, rel):
    out, lines, i = [], text.split("\n"), 0
    while i < len(lines):
        ln, start = lines[i], i
        for pat, what in REFUSE:
            if pat.search(ln):
                raise Unsupported(f"{where}:{i+1}: {what} -- teach the converter "
                                  f"or change the document: {ln.strip()[:60]}")
        if ln.startswith("```"):
            j = i + 1
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            body = html.escape("\n".join(lines[i+1:j]))
            out.append(f"<pre><code>{body}</code></pre>")
            i = j + 1
        elif ln.startswith("<picture>"):
            j = i
            while j < len(lines) and "</picture>" not in lines[j]:
                j += 1
            out.append("\n".join(lines[i:j+1]))
            i = j + 1
        elif ln.startswith("<"):
            if not ln.lstrip().startswith(RAW_OK):
                raise Unsupported(f"{where}:{i+1}: raw HTML <{ln.strip()[1:20]}")
            out.append(ln)
            i += 1
        elif re.match(r"^#{1,3} ", ln):
            n = len(ln) - len(ln.lstrip("#"))
            t = ln[n+1:].strip()
            out.append(f'<h{n} id="{slug(t)}">{inline(t, rel)}</h{n}>')
            i += 1
        elif re.match(r"^-{3,}$", ln):
            out.append("<hr>")
            i += 1
        elif ln.startswith("|"):
            rows, j = [], i
            while j < len(lines) and lines[j].startswith("|"):
                rows.append([c.strip() for c in lines[j].strip("|").split("|")])
                j += 1
            head, body = rows[0], rows[2:] if len(rows) > 1 and set(
                "".join(rows[1]).replace("|", "")) <= set("-: ") else rows[1:]
            th = "".join(f"<th>{inline(c, rel)}</th>" for c in head)
            tb = "".join("<tr>" + "".join(f"<td>{inline(c, rel)}</td>" for c in r)
                         + "</tr>" for r in body)
            # An empty header row means the table is a key/value block rather
            # than data, and is laid out as one.
            cls = "tw facts" if not "".join(head).strip() else "tw"
            out.append(f'<div class="{cls}"><table><thead><tr>{th}</tr></thead>'
                       f"<tbody>{tb}</tbody></table></div>")
            i = j
        elif ln.startswith(">"):
            j, buf = i, []
            while j < len(lines) and lines[j].startswith(">"):
                buf.append(lines[j].lstrip(">").lstrip(" "))
                j += 1
            kind = ""
            m = re.match(r"\[!(\w+)\]", buf[0] if buf else "")
            if m:
                kind = " alert " + m.group(1).lower()
                buf = buf[1:]
            out.append(f'<blockquote class="q{kind}">'
                       + convert("\n".join(buf), where, rel) + "</blockquote>")
            i = j
        elif re.match(r"^[-*] ", ln) or re.match(r"^\d+\. ", ln):
            tag = "ul" if re.match(r"^[-*] ", ln) else "ol"
            items, j = [], i
            pat = r"^[-*] " if tag == "ul" else r"^\d+\. "
            while j < len(lines) and (re.match(pat, lines[j])
                                      or (items and lines[j].startswith("  ")
                                          and lines[j].strip())):
                if re.match(pat, lines[j]):
                    items.append(re.sub(pat, "", lines[j]))
                else:
                    items[-1] += " " + lines[j].strip()
                j += 1
            li = "".join(f"<li>{inline(x, rel)}</li>" for x in items)
            out.append(f"<{tag}>{li}</{tag}>")
            i = j
        elif ln.strip() == "":
            i += 1
        else:
            # Always consume the opening line. A paragraph that starts with a
            # character another block also starts with -- a backtick, most often
            # -- otherwise matches the continuation test, buffers nothing, and
            # leaves the cursor where it was.
            buf, j = [lines[i]], i + 1
            while j < len(lines) and lines[j].strip() and not BLOCK.match(lines[j]):
                buf.append(lines[j])
                j += 1
            out.append(f"<p>{inline(' '.join(buf), rel)}</p>")
            i = j
        if i <= start:
            raise Unsupported(f"{where}:{start+1}: the converter consumed no "
                              f"input here and would not terminate: "
                              f"{lines[start].strip()[:60]!r}")
    return "\n".join(out)


# ---------------------------------------------------------------------- page

