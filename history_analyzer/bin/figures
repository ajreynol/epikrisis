#!/usr/bin/env python3
"""figures -- render a run's evidence as SVG, one pair per theme.

Charts in this repository are **derived from a run's own evidence**, for the
reason every other figure here is: a chart drawn by hand is a number copied into
prose, and it goes stale without anybody editing it. This reads `corpus.json`
and writes SVG beside it, so re-running it after a re-pin redraws the chart or
fails, and never silently disagrees.

**It is not part of the analyzer and must never become part of it.** It reads no
history, runs no `git`, and decides nothing: it is a renderer, and the pipeline's
output does not depend on it. `epikrisis budget` parses `bin/epikrisis` alone and
does not meter this file -- recorded in ../docs/notes.md rather than relied on.

    figures <run-dir>

Reads, from <run-dir>:

  corpus.json     required. Panel 1 is commits per source, and is derived.
  figures.json    optional. Declares further panels the pipeline cannot derive
                  -- a windowed count, say -- each carrying the command that
                  produces it. A panel with no `command` is refused: a hand-read
                  series with no stated derivation is the thing this repository
                  exists to complain about.

Writes `census-light.svg` and `census-dark.svg`. Stdlib only, no network.
"""
import json
import os
import sys

THEMES = {
    "light": dict(bg="#ffffff", ink="#15181d", ink2="#3e454f", ink3="#6b737f",
                  rule="#d8d8d4", derived="#2470B8", declared="#A8721C"),
    "dark":  dict(bg="#0d1117", ink="#e7e9ec", ink2="#b3b9c2", ink3="#848b96",
                  rule="#2c313a", derived="#4694D8", declared="#B5842B"),
}
# Both pairs pass the lightness band, chroma floor, CVD separation and contrast
# checks against their own surface. They carry provenance and never rank:
# `derived` is what the pipeline produced, `declared` is what somebody counted.

# A three-panel figure at full panel width renders wider than any page that
# carries it, and the browser scales the text down with it. Panels get narrower
# as they get more numerous so the type stays the size it was designed at.
WIDTHS = {1: 460, 2: 400, 3: 300}
GAPS = {1: 60, 2: 60, 3: 34}
PANEL_W, GAP, LEFT, ROW_H, TOP = 400, 60, 20, 25, 116
LBL_W, VAL_W = 76, 40
MONO = "ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"
SANS = "-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif"


def esc(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace('"', "&quot;")


def panel(x, rows, title, sub, colour, t, foot, emphasise):
    bar_x, bar_w = x + LBL_W + 10, PANEL_W - LBL_W - VAL_W - 20
    mx = max([v for _, v in rows]) or 1
    o = [f'<text x="{x}" y="{TOP-44}" font-family="{SANS}" font-size="14.5" '
         f'font-weight="600" fill="{t["ink"]}">{esc(title)}</text>',
         f'<text x="{x}" y="{TOP-26}" font-family="{SANS}" font-size="11.5" '
         f'fill="{t["ink3"]}">{esc(sub)}</text>',
         f'<line x1="{x}" y1="{TOP-16}" x2="{x+PANEL_W}" y2="{TOP-16}" '
         f'stroke="{t["rule"]}" stroke-width="1"/>']
    for i, (name, v) in enumerate(rows):
        cy = TOP + i * ROW_H + ROW_H / 2
        hot = name in emphasise
        ink = t["ink"] if hot else t["ink2"]
        w8 = ' font-weight="600"' if hot else ""
        o.append(f'<text x="{x+LBL_W}" y="{cy+4}" text-anchor="end" '
                 f'font-family="{MONO}" font-size="11" fill="{ink}"{w8}>'
                 f'{esc(name)}</text>')
        if v == 0:
            # A zero is absence, not a short bar. Hatching says so at a glance.
            o.append(f'<rect x="{bar_x}" y="{cy-5}" width="30" height="10" '
                     f'rx="2" fill="url(#hatch)"/>')
        else:
            w = max(2.0, bar_w * v / mx)
            o.append(f'<path d="M{bar_x} {cy-7.5} h{w-4} a4 4 0 0 1 4 4 v7 '
                     f'a4 4 0 0 1 -4 4 h{-(w-4)} z" fill="{colour}"/>')
        o.append(f'<text x="{x+PANEL_W}" y="{cy+4}" text-anchor="end" '
                 f'font-family="{MONO}" font-size="11" fill="{ink}"{w8}>'
                 f'{v:,}</text>')
    fy = TOP + len(rows) * ROW_H + 16
    o.append(f'<line x1="{x}" y1="{fy-12}" x2="{x+PANEL_W}" y2="{fy-12}" '
             f'stroke="{t["rule"]}" stroke-width="1"/>')
    o.append(f'<text x="{x}" y="{fy+4}" font-family="{MONO}" font-size="10" '
             f'fill="{t["ink3"]}">{esc(foot)}</text>')
    return "\n".join(o)


def render(mode, panels, heading, subheading, alt, n_rows):
    global PANEL_W, GAP
    PANEL_W = WIDTHS.get(len(panels), 260)
    GAP = GAPS.get(len(panels), 30)
    t = THEMES[mode]
    w = LEFT * 2 + len(panels) * PANEL_W + (len(panels) - 1) * GAP
    h = TOP + n_rows * ROW_H + 50
    o = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {h}" '
         f'width="{w}" height="{h}" role="img" aria-label="{esc(alt)}">',
         f'<defs><pattern id="hatch" width="6" height="6" '
         f'patternTransform="rotate(135)" patternUnits="userSpaceOnUse">'
         f'<line x1="0" y1="0" x2="0" y2="6" stroke="{t["rule"]}" '
         f'stroke-width="3"/></pattern></defs>',
         f'<rect width="{w}" height="{h}" fill="{t["bg"]}"/>',
         f'<text x="{LEFT}" y="30" font-family="{SANS}" font-size="16" '
         f'font-weight="600" fill="{t["ink"]}">{esc(heading)}</text>',
         f'<text x="{LEFT}" y="50" font-family="{SANS}" font-size="11.5" '
         f'fill="{t["ink3"]}">{esc(subheading)}</text>']
    for i, p in enumerate(panels):
        o.append(panel(LEFT + i * (PANEL_W + GAP), p["rows"], p["title"],
                       p["sub"], t[p["colour"]], t, p["foot"], p["emphasise"]))
    o.append("</svg>")
    return "\n".join(o) + "\n"


def main():
    if len(sys.argv) != 2:
        raise SystemExit("usage: figures <run-dir>")
    rd = sys.argv[1]
    corpus = json.load(open(os.path.join(rd, "corpus.json")))
    order = sorted(corpus["sources"], key=lambda s: -s["commits"])
    ids = [s["id"] for s in order]
    total = sum(s["commits"] for s in order)

    def corpus_panel():
        return dict(
            rows=[(s["id"], s["commits"]) for s in order],
            title="Whole history, to the pin",
            sub=f"{total:,} commits \u00b7 derived from corpus.json",
            colour="derived", emphasise={ids[0]},
            foot=f"max {order[0]['commits']:,} \u2014 {ids[0]} is "
                 f"{100*order[0]['commits']/total:.1f}% of all of it"), \
            ("Whole history: " + ", ".join(f"{s['id']} {s['commits']}"
                                           for s in order) + f" \u2014 {total:,} total.")

    def series_panel(ser):
        if not ser.get("command"):
            raise SystemExit(f"figures: series {ser['id']!r} states no command "
                             "that produces it; a hand-read series without its "
                             "derivation is not renderable here")
        vals = ser["values"]
        missing = [i for i in ids if i not in vals]
        if missing:
            raise SystemExit(f"figures: series {ser['id']!r} is missing "
                             f"{', '.join(missing)}; a panel drawn over a "
                             "different set than the pin is a chart nobody "
                             "measured")
        rows = [(i, vals[i]) for i in ids]
        st = sum(v for _, v in rows)
        top = max(rows, key=lambda r: r[1])
        return dict(
            rows=rows, title=ser["label"],
            sub=f"{st:,} commits \u00b7 {ser.get('provenance', 'declared')}",
            colour="declared",
            emphasise={top[0]} | {i for i, v in rows if v == 0},
            foot=f"max {top[1]:,} \u2014 hatched = zero in the window"), \
            (f" {ser['label']}: " + ", ".join(f"{i} {v}" for i, v in rows)
             + f" \u2014 {st:,} total.")

    available = {"corpus": corpus_panel}
    declared = []
    fp = os.path.join(rd, "figures.json")
    if os.path.exists(fp):
        spec = json.load(open(fp))
        for ser in spec.get("series", []):
            available[ser["id"]] = (lambda s=ser: series_panel(s))
            declared.append(ser["id"])
        # Without an explicit list there is one figure holding everything, which
        # is what the first version of this did and what the existing runs expect.
        figures = spec.get("figures") or [
            {"name": "census", "panels": ["corpus"] + declared}]
    else:
        figures = [{"name": "census", "panels": ["corpus"]}]

    sub = (f"{len(ids)} sources at the {corpus['pinned']} pin. Same order in "
           f"every panel; each panel has its own scale.")
    for fig in figures:
        unknown = [p for p in fig["panels"] if p not in available]
        if unknown:
            raise SystemExit(f"figures: figure {fig['name']!r} names panel(s) "
                             f"{', '.join(unknown)}, which nothing declares")
        panels, alt = [], "Commits per repository."
        for name in fig["panels"]:
            panel_, a = available[name]()
            panels.append(panel_)
            alt += " " + a
        heading = fig.get("heading",
                          f"Commits per repository, {corpus['subject']}")
        for mode in ("light", "dark"):
            out = os.path.join(rd, f"{fig['name']}-{mode}.svg")
            open(out, "w").write(render(mode, panels, heading, sub, alt, len(ids)))
            print(f"  wrote {out}")


if __name__ == "__main__":
    main()
